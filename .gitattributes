*.sch text eol=lf
*.sym text eol=lf
layout/** text eol=lf
layout/**/*.gds binary
layout/**/*.gz binary
layout/**/*.png binary
layout/**/*.pdf binary
# Preserve tool-produced evidence and SVG paths verbatim.
layout/release/** -whitespace
layout/figures/*.svg -whitespace
# Preserve generated vector formatting and raw simulator progress output.
layout/reviews/**/*.svg -whitespace
layout/reviews/**/ngspice.log -text -whitespace
layout/release/**/ngspice.log -text -whitespace
